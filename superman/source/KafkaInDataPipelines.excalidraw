    {
      "id": "h9h79m72NO6z3iJ5ImyJV",
      "type": "text",
      "x": 369,
      "y": 736,
      "width": 1385.998291015625,
      "height": 1325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
