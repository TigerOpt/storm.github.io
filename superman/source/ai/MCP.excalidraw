    {
      "id": "wdE84J0rsbXeE1-IWmNGH",
      "type": "text",
      "x": 491,
      "y": 2180,
      "width": 1065.319580078125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b16",
      "roundness": null,
      "seed": 1862676347,
      "version": 168,
      "versionNonce": 2097022427,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762449310122,
      "link": null,
      "locked": false,
      "text": "MCP是一种通信协议，它和REST和gRPC有所差异，REST是无状态协议，gRPC提供双向通道，而MCP为有状态的代理\n对话提供了标准化协议。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MCP是一种通信协议，它和REST和gRPC有所差异，REST是无状态协议，gRPC提供双向通道，而MCP为有状态的代理\n对话提供了标准化协议。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HVb1fmCavAArOyBwEgRU0",
      "type": "line",
      "x": 581,
      "y": 2231,
      "width": 118,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
