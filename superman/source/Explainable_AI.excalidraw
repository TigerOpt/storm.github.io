      "index": "a6",
      "roundness": null,
      "seed": 1505738811,
      "version": 22,
      "versionNonce": 517626459,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756881467134,
      "link": null,
      "locked": false,
      "text": "Counterfactuals：反事实是与原始图像相似但预测发生了变化的图像。分析这些反事实有助于我们了解哪些图像像素/区域对预测很重要。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Counterfactuals：反事实是与原始图像相似但预测发生了变化的图像。分析这些反事实有助于我们了解哪些图像像素/区域对预测很重要。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_6kXW7x8_CV_gGXsrvDxE",
      "type": "text",
      "x": 175,
      "y": 689,
      "width": 1400.7197265625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
