      "index": "a8",
      "roundness": null,
      "seed": 1306596411,
      "version": 23,
      "versionNonce": 202391675,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756881499583,
      "link": null,
      "locked": false,
      "text": "Perturbation Based：基于扰动的方法根据图像区域或像素的去除（通过扰动或遮挡）如何影响模型的预测，为图像区域或像素分配重要性分数来产生解释。 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Perturbation Based：基于扰动的方法根据图像区域或像素的去除（通过扰动或遮挡）如何影响模型的预测，为图像区域或像素分配重要性分数来产生解释。 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
