    {
      "id": "1Rr9dz2Rhk9LoESLkBEzR",
      "type": "text",
      "x": 353.40985107421875,
      "y": 4991.5,
      "width": 1374.998291015625,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "C7GLaDmGX51p660BUZaoT",
      "index": "b1nV",
      "roundness": null,
      "seed": 1021759161,
      "version": 9,
      "versionNonce": 1891951959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1750405098446,
      "link": null,
      "locked": false,
      "text": "import org.apache.hadoop.io.IntWritable;\nimport org.apache.hadoop.io.LongWritable;\nimport org.apache.hadoop.io.Text;\nimport org.apache.hadoop.mapreduce.Reducer;\n\nimport java.io.IOException;\n\npublic class CarReducer extends Reducer<Text, IntWritable, Text, LongWritable> {\n    @Override\n    protected void reduce(Text key, Iterable<IntWritable> values, Context context) throws IOException, InterruptedException {\n        long sum = 0;\n\n        for (IntWritable occurrence : values) {\n            sum += occurrence.get();\n        }\n\n        context.write(key, new LongWritable(sum));\n    }\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import org.apache.hadoop.io.IntWritable;\nimport org.apache.hadoop.io.LongWritable;\nimport org.apache.hadoop.io.Text;\nimport org.apache.hadoop.mapreduce.Reducer;\n\nimport java.io.IOException;\n\npublic class CarReducer extends Reducer<Text, IntWritable, Text, LongWritable> {\n    @Override\n    protected void reduce(Text key, Iterable<IntWritable> values, Context context) throws IOException, InterruptedException {\n        long sum = 0;\n\n        for (IntWritable occurrence : values) {\n            sum += occurrence.get();\n        }\n\n        context.write(key, new LongWritable(sum));\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C7GLaDmGX51p660BUZaoT",
