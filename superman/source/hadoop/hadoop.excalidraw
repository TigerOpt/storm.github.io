    {
      "id": "DBdQbrDBgWXpikBPVd5k0",
      "type": "text",
      "x": 309,
      "y": 35,
      "width": 657.8197021484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 458758137,
      "version": 6,
      "versionNonce": 1029473207,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1750386813189,
      "link": null,
      "locked": false,
      "text": "Hadoop 是一个可靠、分布式和可扩展的平台，用于存储和分析海量数据。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hadoop 是一个可靠、分布式和可扩展的平台，用于存储和分析海量数据。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eaJV5_hqCZIsyjCiK3wxr",
      "type": "text",
      "x": 310.40985107421875,
      "y": 176.5,
      "width": 57.099945068359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 359493687,
