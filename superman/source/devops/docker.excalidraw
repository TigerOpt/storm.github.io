      "link": null,
      "locked": false,
      "text": "# Base image\nFROM python:alpine\n\n# Copy app, templates and views\nCOPY . /app\n\n# Set working directory for subsequent commands\nWORKDIR /app\n\n# Install dependencies\nRUN pip install -r requirements.txt\n\nEXPOSE 8080\n\n# Command to run when container starts\nENTRYPOINT [\"python\", \"app/app.py\"]\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Base image\nFROM python:alpine\n\n# Copy app, templates and views\nCOPY . /app\n\n# Set working directory for subsequent commands\nWORKDIR /app\n\n# Install dependencies\nRUN pip install -r requirements.txt\n\nEXPOSE 8080\n\n# Command to run when container starts\nENTRYPOINT [\"python\", \"app/app.py\"]\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
